# MenuMaster Backend - Apache Configuration for Public Directory

# Enable URL Rewriting
RewriteEngine On

# Handle API Routes - but allow direct PHP file access
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.php$
RewriteRule ^(.*)$ index.php [QSA,L]

# Security Headers
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options nosniff
    
    # Prevent clickjacking
    Header always set X-Frame-Options DENY
    
    # HSTS (HTTP Strict Transport Security)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Handle OPTIONS requests for CORS preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ index.php [QSA,L]

# Protect sensitive files
<Files ".env">
    Require all denied
</Files>

<Files "composer.json">
    Require all denied
</Files>

<Files "composer.lock">
    Require all denied
</Files>

# Deny access to config files
<FilesMatch "\.(json|lock|md|txt|log)$">
    Require all denied
</FilesMatch>

# Allow specific file types
<FilesMatch "\.(php|css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Require all granted
</FilesMatch>