{
    "name": "menumaster/backend",
    "description": "A comprehensive restaurant management system backend with order management, inventory control, and business analytics",
    "type": "project",
    "keywords": ["restaurant", "management", "pos", "inventory", "php", "api"],
    "license": "proprietary",
    "authors": [
        {
            "name": "MenuMaster Development Team",
            "email": "dev@menumaster.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "^6.11",
        "phpmailer/phpmailer": "*",
        "setasign/fpdf": "^1.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "App/"
        },
        "files": [
            "App/config/Constantes.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "setup": "php setup_analisis_avanzado.php",
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "*": true
        }
    }
}
